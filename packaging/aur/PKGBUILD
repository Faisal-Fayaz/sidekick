# Maintainer: Irfanwani <irfanwani347@gmail.com>
# Arch User Repository package for the sidekick-agent PyPI package.
# Publish flow: bump __version__ in src/sk/__init__.py and merge to main; the
# release workflow publishes to PyPI and creates the vX.Y.Z tag itself. Do NOT
# push a tag by hand -- on.push filters on branches, so a tag push runs no
# workflow at all. Then refresh pkgver + source URL + sha256sums below from
# https://pypi.org/pypi/sidekick-agent/<version>/json and upload to AUR.

pkgname=python-sidekick-agent
_pkgname=sidekick-agent
pkgver=0.32.0
pkgrel=1
pkgdesc="Local-first terminal companion agent (Ollama-powered) — CLI 'sk'"
arch=("any")
url="https://github.com/Faisal-Fayaz/sidekick"
license=("MIT")
depends=(
  "python"
  "python-typer"
  "python-rich"
  "python-openai"
  "python-dotenv"
  "python-textual"
  "python-httpx"
)
makedepends=("python-build" "python-installer" "python-wheel" "python-setuptools")
optdepends=("python-faster-whisper: local voice transcription for 'sk talk'")
source=("${_pkgname}-${pkgver}.tar.gz::https://files.pythonhosted.org/packages/d6/19/d320a8261527b6757fd9f766c23bad18685d73e606e7d2b86850f6a74636/${_pkgname}-${pkgver}.tar.gz")
sha256sums=("08533b98412c7b543c1207beac17d845af224de0d82ea9521029ae40924d2afd")

build() {
  python -m build --wheel --no-isolation
}

package() {
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}